# Copy this file to .env and edit the path below.
# The folder you point at is your existing media library — the folder that CONTAINS
# creator subfolders of audio files. This app itself must live inside that folder as
# a subfolder named exactly "Sasayaki" (see INSTALL.md for why).
#
# Windows example:  SASAYAKI_LIBRARY=D:/Music/Asmr
# Linux/macOS example: SASAYAKI_LIBRARY=/home/you/Music/Asmr
SASAYAKI_LIBRARY=/path/to/your/library
